<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="kr.moare.android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>

    <application
        android:name=".MoareApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher_moare"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_moare_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Moare"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Moare.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>

                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>

                <data
                    android:host="10.0.2.2:8080"
                    android:scheme="http"/>
            </intent-filter>
        </activity>
        <activity android:name=".view.message.MessagesActivity"/>
        <activity android:name="com.canhub.cropper.CropImageActivity"
            android:theme="@style/Theme.Moare"/>
    </application>

</manifest>